# Copy to .env and change every value marked "change-me".
# `deploy/scripts/install.sh` does this automatically with random passwords.

# Port exposed by the web container.
WEB_PORT=8080

# PostgreSQL.
DB_NAME=genisource_erp
DB_USER=erp
DB_PASSWORD=change-me-db-password

# Initial administrator. Must be changed before the instance is reachable by others.
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=change-me-admin-password
ERP_FORCE_PASSWORD_CHANGE=true

# HMAC key for JWT signing. At least 32 bytes; rotate to sign out all sessions.
ERP_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long

# Multi-tenant mode: single (private deployment, one tenant) | multi (SaaS).
ERP_TENANT_MODE=single
ERP_DEFAULT_TENANT=default

# demo = load sample factory data. Use "prod" for a clean database.
SPRING_PROFILES_ACTIVE=demo

# Genisource MES integration (optional). Leave blank to run standalone.
MES_BASE_URL=
MES_CLIENT_ID=
MES_CLIENT_SECRET=
MES_SYNC_ENABLED=false

# Mirrors for image builds: central | aliyun, and the npm registry.
MAVEN_MIRROR=central
NPM_REGISTRY=https://registry.npmjs.org
