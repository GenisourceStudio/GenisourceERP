<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.genisource</groupId>
        <artifactId>genisource-erp</artifactId>
        <version>0.1.0-alpha</version>
    </parent>

    <artifactId>erp-purchase</artifactId>
    <name>Genisource ERP :: Purchase</name>
    <description>Purchase requisitions, orders and goods receipts</description>

    <dependencies>
        <dependency>
            <groupId>com.genisource</groupId>
            <artifactId>erp-platform</artifactId>
        </dependency>

        <dependency>
            <groupId>com.genisource</groupId>
            <artifactId>erp-masterdata</artifactId>
        </dependency>

        <!-- Posting a receipt or a shipment writes stock. The dependency runs one way,
             and the call is a plain service call so both sides commit together. -->
        <dependency>
            <groupId>com.genisource</groupId>
            <artifactId>erp-inventory</artifactId>
        </dependency>

        <!-- A posted receipt or shipment creates a payable or a receivable. -->
        <dependency>
            <groupId>com.genisource</groupId>
            <artifactId>erp-finance</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
